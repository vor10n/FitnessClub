<Window x:Class="FitnessClub.ScheduleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Занятие" Height="540" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtTitle" Text="Новое занятие" FontSize="20" FontWeight="Bold" Foreground="#4285B4" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Тренировка *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbWorkout" Height="33" FontSize="14" VerticalContentAlignment="Center" SelectionChanged="CmbWorkout_SelectionChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Дата *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <DatePicker x:Name="DpDate" Height="33" FontSize="14" VerticalContentAlignment="Center" SelectedDateChanged="DpDate_SelectedDateChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Время начала * (чч:мм)" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtStartTime" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center" LostFocus="TxtStartTime_LostFocus"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Время окончания" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtEndTime" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center" IsReadOnly="True" Background="#EEE"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Зал *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtRoom" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="130" Height="27" Background="#27AE60" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="110" Height="27" Margin="10,0,0,0" Background="#BDC3C7" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>