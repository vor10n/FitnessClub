<Window x:Class="FitnessClub.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник" Height="647" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="25,25,25,13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="46.6"/>
            <RowDefinition Height="Auto" MinHeight="63.96"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtTitle" Text="Новый сотрудник" FontSize="20" FontWeight="Bold" Foreground="#4285B4" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Имя *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtFirstName" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Фамилия *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLastName" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Телефон *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtPhone" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,63,0,10" Grid.RowSpan="2">
            <TextBlock Text="Email" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtEmail" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,64,0,10" Grid.RowSpan="2">
            <TextBlock Text="Должность *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbPosition" Height="33" FontSize="14" VerticalContentAlignment="Center">
                <ComboBoxItem Content="Тренер"/>
                <ComboBoxItem Content="Администратор"/>
                <ComboBoxItem Content="Менеджер"/>
                <ComboBoxItem Content="Техник"/>
                <ComboBoxItem Content="Уборщица"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,64,0,10" Grid.RowSpan="2">
            <TextBlock Text="Зарплата" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtSalary" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,64,0,10" Grid.RowSpan="2">
            <TextBlock Text="Дата приема" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <DatePicker x:Name="DpHireDate" Height="33" FontSize="14" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0" Width="250">
            <Button Content="Сохранить" Width="130" Height="27" Background="#27AE60" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="110" Height="27" Margin="10,0,0,0" Background="#BDC3C7" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>