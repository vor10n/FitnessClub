<Window x:Class="FitnessClub.WorkoutEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тренировка" Height="560" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtTitle" Text="Новая тренировка" FontSize="20" FontWeight="Bold" Foreground="#4285B4" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Название *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtTitle2" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Описание" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtDescription" Height="60" FontSize="14" Padding="8,5,0,0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Тренер *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbTrainer" Height="33" FontSize="14" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Макс. участников *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtMaxParticipants" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Длительность (мин) *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtDuration" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="130" Height="27" Background="#27AE60" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="110" Height="27" Margin="10,0,0,0" Background="#BDC3C7" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>