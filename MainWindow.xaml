<Window x:Class="FitnessClub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель управления" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#4285B4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Фитнес-Клуб" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,25,0,30"/>
                <StackPanel Grid.Row="1">
                    <Button Content="Клиенты" Style="{StaticResource NavButton}" Click="BtnClients_Click"/>
                    <Button Content="Абонементы" Style="{StaticResource NavButton}" Click="BtnMemberships_Click"/>
                    <Button Content="Тренеры" Style="{StaticResource NavButton}" Click="BtnTrainers_Click"/>
                    <Button Content="Тренировки" Style="{StaticResource NavButton}" Click="BtnWorkouts_Click"/>
                    <Button Content="Расписание" Style="{StaticResource NavButton}" Click="BtnSchedule_Click"/>
                    <Button Content="Бронирования" Style="{StaticResource NavButton}" Click="BtnBookings_Click"/>
                    <Button Content="Сотрудники" Style="{StaticResource NavButton}" Click="BtnEmployees_Click"/>
                </StackPanel>
                <Button Grid.Row="2" Content="Выход" Style="{StaticResource NavButton}" Click="BtnLogout_Click" Margin="0,0,0,15"/>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TxtHeader" Text="Главная" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="25,0,0,0" Foreground="#4285B4"/>
                    <TextBlock x:Name="TxtUser" Text="" FontSize="14" Foreground="#7F8C8D" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0"/>
                </Grid>
            </Border>
            <ContentControl x:Name="MainContent" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>