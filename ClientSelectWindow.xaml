<Window x:Class="FitnessClub.ClientSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор клиента" Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="TxtSearch" Grid.Row="0" Height="35" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center" Margin="0,0,0,15" TextChanged="TxtSearch_TextChanged"/>

        <DataGrid x:Name="DgClients" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9" BorderBrush="#DDD" BorderThickness="1" MouseDoubleClick="DgClients_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ClientID}" Width="60"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="150"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="150"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Выбрать" Width="120" Height="27" Background="#27AE60" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnSelect_Click"/>
            <Button Content="Отмена" Width="110" Height="27" Margin="10,0,0,0" Background="#BDC3C7" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>