<UserControl x:Class="FitnessClub.Controls.BookingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Бронирования" FontSize="22" FontWeight="Bold" Foreground="#4285B4" Margin="0,0,0,15"/>
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Дата:" VerticalAlignment="Center" FontSize="14" Foreground="#2C3E50" Margin="0,0,8,0"/>
            <DatePicker x:Name="DpDate" Grid.Column="1" Height="35" FontSize="14" VerticalContentAlignment="Center" SelectedDateChanged="DpDate_SelectedDateChanged"/>
            <TextBlock Grid.Column="2" Text="Статус:" VerticalAlignment="Center" FontSize="14" Foreground="#2C3E50" Margin="15,0,8,0"/>
            <ComboBox x:Name="CmbStatus" Grid.Column="3" Height="35" FontSize="14" VerticalContentAlignment="Center" SelectionChanged="CmbStatus_SelectionChanged">
                <ComboBoxItem Content="Все" IsSelected="True"/>
                <ComboBoxItem Content="Активно"/>
                <ComboBoxItem Content="Отменено"/>
                <ComboBoxItem Content="Завершено"/>
            </ComboBox>
            <TextBlock Grid.Column="4" Text="Поиск:" VerticalAlignment="Center" FontSize="14" Foreground="#2C3E50" Margin="15,0,8,0"/>
            <TextBox x:Name="TxtSearch" Grid.Column="5" Height="35" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>
            <Button Grid.Column="6" Content="Записать" Width="110" Height="35" Margin="10,0,0,0" Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAdd_Click"/>
            <Button Grid.Column="7" Content="Отменить" Width="110" Height="35" Margin="10,0,0,0" Background="#F39C12" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
            <Button Grid.Column="8" Content="Удалить" Width="100" Height="35" Margin="10,0,0,0" Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnDelete_Click"/>
        </Grid>
        <DataGrid x:Name="DgBookings" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9" BorderBrush="#DDD" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding BookingID}" Width="60"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientFullName}" Width="200"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding ClientPhone}" Width="140"/>
                <DataGridTextColumn Header="Тренировка" Binding="{Binding WorkoutTitle}" Width="180"/>
                <DataGridTextColumn Header="Тренер" Binding="{Binding TrainerName}" Width="170"/>
                <DataGridTextColumn Header="Дата занятия" Binding="{Binding StartTime, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                <DataGridTextColumn Header="Зал" Binding="{Binding Room}" Width="90"/>
                <DataGridTextColumn Header="Дата записи" Binding="{Binding BookingDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>