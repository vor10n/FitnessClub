<UserControl x:Class="FitnessClub.Controls.ClientsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Список клиентов" FontSize="22" FontWeight="Bold" Foreground="#4285B4" Margin="0,0,0,15"/>
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSearch" Grid.Column="0" Height="35" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged"/>

            <Button Grid.Column="2" Content="Добавить" Width="110" Height="35" Margin="10,0,0,0" Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAdd_Click"/>
            <Button Grid.Column="3" Content="Редактировать" Width="130" Height="35" Margin="10,0,0,0" Background="#F39C12" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnEdit_Click"/>
            <Button Grid.Column="4" Content="Удалить" Width="100" Height="35" Margin="10,0,0,0" Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnDelete_Click"/>
        </Grid>
        <DataGrid x:Name="DgClients" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9" BorderBrush="#DDD" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ClientID}" Width="60"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="150"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="150"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="150"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                <DataGridTextColumn Header="Дата рождения" Binding="{Binding DateOfBirth, StringFormat=dd.MM.yyyy}" Width="130"/>
                <DataGridTextColumn Header="Дата регистрации" Binding="{Binding RegistrationDate, StringFormat=dd.MM.yyyy}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>