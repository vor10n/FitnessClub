<Window x:Class="FitnessClub.TrainerEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тренер" Height="520" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TxtTitle" Text="Новый тренер" FontSize="20" FontWeight="Bold" Foreground="#4285B4" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Имя *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtFirstName" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Фамилия *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtLastName" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Телефон *" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtPhone" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Text="Специализация" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtSpecialization" Height="33" FontSize="14" Padding="8,0,0,0" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Text="Дата приема" Foreground="#2C3E50" Margin="0,0,0,5"/>
            <DatePicker x:Name="DpHireDate" Height="33" FontSize="14" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Сохранить" Width="130" Height="27" Background="#27AE60" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="110" Height="27" Margin="10,0,0,0" Background="#BDC3C7" Foreground="White" FontSize="14" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>